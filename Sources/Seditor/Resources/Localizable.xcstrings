    "help.shortcuts.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keyboard Shortcuts\n\nCommand+N   New\nCommand+O   Open\nCommand+S   Save\nShift+Command+S   Save As\nCommand+L   Go to Line\nCommand+F   Find\nOption+Command+F   Replace\nCommand+G   Find Next\nShift+Command+G   Find Previous\nCommand+T   New Tab\nCommand+W   Close Tab / Close Window\nOption+Command+W   Close All Tabs\nControl+Command+F   Enter/Exit Full Screen"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "快捷键\n\nCommand+N   新建\nCommand+O   打开\nCommand+S   保存\nShift+Command+S   另存为\nCommand+L   跳转到行\nCommand+F   查找\nOption+Command+F   替换\nCommand+G   查找下一个\nShift+Command+G   查找上一个\nCommand+T   新建标签页\nCommand+W   关闭标签页 / 关闭窗口\nOption+Command+W   关闭全部标签页\nControl+Command+F   进入/退出全屏"
          }
        }
      }
    },
